# Frontend environment variables for Netlify
# Set these in the Netlify dashboard under Site Settings → Environment Variables
# They are baked into the JS bundle at build time by Vite (VITE_ prefix required)

# ── WebSocket: direct connection to Render backend (Netlify cannot proxy WS) ──
# This is ONLY used for the WebSocket connection. Do NOT add a trailing slash.
VITE_BACKEND_URL=https://meet-scribe-zw7b.onrender.com

# ── HTTP REST: handled by Netlify proxy (see netlify.toml [[redirects]]) ──────
# Leave VITE_API_BASE unset in Netlify — the app uses relative /api/* paths,
# which the Netlify proxy forwards to the Render backend automatically.
# (Avoids Mixed Content errors: HTTPS frontend → HTTP backend)

# ── Firebase (baked into the frontend bundle) ─────────────────────────────────
VITE_FB_API_KEY=your_firebase_api_key
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=your_sender_id
VITE_FB_APP_ID=your_app_id
