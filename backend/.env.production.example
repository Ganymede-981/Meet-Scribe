# ─── Required: API Keys ────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Firebase Admin SDK ────────────────────────────────────────
# On AWS/Docker, paste the ENTIRE serviceAccountKey.json as a
# single-line JSON string (NOT a file path). Example:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Server ───────────────────────────────────────────────────
PORT=3001
# Set this to your CloudFront URL or the domain of your frontend:
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net
NODE_ENV=production
