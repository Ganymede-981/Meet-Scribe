# ─── Frontend Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your real values for local development.
# For Netlify: set these in Site Settings → Environment Variables (UI).
# For Docker: pass them as build-args in docker-compose.yml (already wired up).
# NEVER commit this file with real values to version control.

# ── Backend URL ──────────────────────────────────────────────────────────────
# URL of your backend server (no trailing slash).
# Local dev:   http://localhost:3001
# Production:  https://your-backend.elasticbeanstalk.com
VITE_BACKEND_URL=http://localhost:3001

# ── Firebase (get from Firebase Console → Project Settings → Your apps) ──────
VITE_FB_API_KEY=your-firebase-api-key
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_STORAGE_BUCKET=your-project.appspot.com
VITE_FB_MESSAGING_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:abc123
