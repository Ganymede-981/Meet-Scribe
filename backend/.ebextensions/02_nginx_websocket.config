files:
  # Extend the EB nginx proxy to pass WebSocket Upgrade headers
  # This is required for /ws connections (real-time transcript streaming)
  "/etc/nginx/conf.d/websocket.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
      }

container_commands:
  01_reload_nginx:
    command: "service nginx reload || true"
